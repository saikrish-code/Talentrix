# =============================================================================
# TALENTRIX — Root Environment Variables Template
# Copy this file to .env and fill in real values.
# Never commit real .env files to version control.
# =============================================================================

# ─── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talentrix
POSTGRES_USER=talentrix_user
POSTGRES_PASSWORD=changeme

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ─── Auth (NextAuth.js) ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# OAuth providers (optional — add any you need)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── S3-Compatible Storage ────────────────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=talentrix-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── AI / LLM Provider ───────────────────────────────────────────────────────
# Set TALENTRIX_AI_PROVIDER to: openai | anthropic | google | azure_openai | ollama
TALENTRIX_AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro

# Azure OpenAI (if provider = azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Ollama (if provider = ollama — for local dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# JWT for API auth (separate from NextAuth session)
JWT_SECRET=generate-another-secret-with-openssl
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (optional — for queues/caching) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (optional — for notifications) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@talentrix.io
