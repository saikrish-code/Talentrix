// ============================================================
// Talentrix — Prisma Schema
// PostgreSQL + pgvector
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  HR_MANAGER
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  CANDIDATE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  CULTURAL_FIT
  FINAL
  HR
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum InterviewDecision {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
  STAFF
  DIRECTOR
  VP
  C_LEVEL
}

enum DocumentType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  OFFER_LETTER
  OTHER
}

// ─── Tenant (multi-tenancy support) ──────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  plan      String   @default("starter")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  jobs       Job[]
  candidates CandidateProfile[]

  @@map("tenants")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String?
  role          UserRole   @default(RECRUITER)
  status        UserStatus @default(ACTIVE)
  avatarUrl     String?
  department    String?
  title         String?
  phone         String?
  emailVerified DateTime?
  tenantId      String?

  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Domain relations
  scheduledInterviews Interview[] @relation("ScheduledBy")
  interviewsAsPanel   InterviewPanel[]
  feedbacks           InterviewFeedback[]
  applicationNotes    ApplicationNote[]
  hiringJobs          Job[]              @relation("HiringManager")
  recruitingJobs      Job[]              @relation("Recruiter")
  candidateProfile    CandidateProfile?  @relation("CandidateUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([tenantId])
  @@map("users")
}

// ─── NextAuth models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Job ──────────────────────────────────────────────────────────────────────

model Job {
  id             String         @id @default(cuid())
  title          String
  department     String
  location       Json           // { city, state, country }
  workMode       WorkMode
  employmentType EmploymentType
  seniority      SeniorityLevel
  status         JobStatus      @default(DRAFT)
  description    String         @db.Text
  requirements   String[]
  niceToHave     String[]
  skills         String[]
  salaryRange    Json?          // { min, max, currency, period }
  openings       Int            @default(1)
  publishedAt    DateTime?
  closedAt       DateTime?
  tenantId       String
  hiringManagerId String
  recruiterId    String?

  // pgvector embedding (1536 dims for text-embedding-3-large)
  embedding      Unsupported("vector(1536)")?

  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  hiringManager  User    @relation("HiringManager", fields: [hiringManagerId], references: [id])
  recruiter      User?   @relation("Recruiter", fields: [recruiterId], references: [id])

  applications   Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("jobs")
}

// ─── Candidate ────────────────────────────────────────────────────────────────

model CandidateProfile {
  id                   String  @id @default(cuid())
  userId               String? @unique
  email                String
  firstName            String
  lastName             String
  phone                String?
  location             String?
  linkedinUrl          String?
  portfolioUrl         String?
  githubUrl            String?
  summary              String? @db.Text
  skills               String[]
  totalExperienceYears Float?
  currentTitle         String?
  currentCompany       String?
  parsedResume         Json?   // ParsedResume shape
  tenantId             String

  // pgvector embedding
  embedding Unsupported("vector(1536)")?

  user      User?   @relation("CandidateUser", fields: [userId], references: [id])
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  documents CandidateDocument[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@map("candidate_profiles")
}

model CandidateDocument {
  id          String       @id @default(cuid())
  candidateId String
  type        DocumentType
  name        String
  s3Key       String
  s3Url       String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime     @default(now())

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_documents")
}

// ─── Application ─────────────────────────────────────────────────────────────

model Application {
  id                   String            @id @default(cuid())
  jobId                String
  candidateId          String
  status               ApplicationStatus @default(APPLIED)
  matchScore           Float?
  matchScoreBreakdown  Json?
  coverLetterText      String?           @db.Text
  source               String?
  referredById         String?
  stageHistory         Json[]
  tenantId             String

  job       Job              @relation(fields: [jobId], references: [id])
  candidate CandidateProfile @relation(fields: [candidateId], references: [id])
  notes     ApplicationNote[]
  interviews Interview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, candidateId])
  @@index([tenantId])
  @@index([status])
  @@map("applications")
}

model ApplicationNote {
  id            String  @id @default(cuid())
  applicationId String
  authorId      String
  content       String  @db.Text
  isPrivate     Boolean @default(false)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@map("application_notes")
}

// ─── Interview ────────────────────────────────────────────────────────────────

model Interview {
  id                    String          @id @default(cuid())
  applicationId         String
  type                  InterviewType
  status                InterviewStatus @default(SCHEDULED)
  round                 Int             @default(1)
  slot                  Json            // { startAt, endAt, timezone, meetingUrl, location }
  aiGeneratedQuestions  String[]
  calendarEventId       String?
  tenantId              String
  scheduledById         String

  application Application     @relation(fields: [applicationId], references: [id])
  scheduledBy User            @relation("ScheduledBy", fields: [scheduledById], references: [id])
  panel       InterviewPanel[]
  feedbacks   InterviewFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("interviews")
}

model InterviewPanel {
  interviewId   String
  interviewerId String

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation(fields: [interviewerId], references: [id])

  @@id([interviewId, interviewerId])
  @@map("interview_panels")
}

model InterviewFeedback {
  id                  String            @id @default(cuid())
  interviewId         String
  interviewerId       String
  decision            InterviewDecision
  overallRating       Int
  technicalRating     Int?
  communicationRating Int?
  cultureFitRating    Int?
  strengths           String            @db.Text
  weaknesses          String            @db.Text
  notes               String            @db.Text
  submittedAt         DateTime          @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation(fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@map("interview_feedbacks")
}
